# deploy/.env 로 복사해서 값을 채운다. 이 파일은 절대 git에 올리지 않는다.
#
#   cp .env.example .env && nano .env
#
# ── 주소 ────────────────────────────────────────────────
# 실제 도메인. 이 값으로 HTTPS 인증서가 발급된다.
DOMAIN=outreach.example.com
BASE_URL=https://outreach.example.com
CORS_ORIGINS=["https://outreach.example.com"]

# ── 데이터 창고 (Supabase) ──────────────────────────────
DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-1-ap-northeast-2.pooler.supabase.com:6543/postgres

# ── 필수 ────────────────────────────────────────────────
ENV=production
# 아래 두 개는 반드시 새로 생성해서 넣는다:
#   python -c "import secrets;print(secrets.token_urlsafe(48))"                      # SECRET_KEY
#   python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"  # ENCRYPTION_KEY
SECRET_KEY=
ENCRYPTION_KEY=

# 관리자로 승격 가능한 계정 (이 이메일로 가입해야 함)
ADMIN_EMAIL=gimuuuujin@gmail.com

# ── 선택 ────────────────────────────────────────────────
# 카카오 로컬 API 키 — 있으면 브라우저 없이 수집 (developers.kakao.com 무료)
KAKAO_REST_API_KEY=

# 계좌이체 결제 안내용
BANK_NAME=
BANK_ACCOUNT=
BANK_HOLDER=
