# Database (Supabase PostgreSQL or local Postgres)
DATABASE_URL=postgresql://postgres:password@db.xxxx.supabase.co:6543/postgres

# Security — 반드시 변경 (production)
# 생성 예: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-production
# 생성 예: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=change-me-in-production

# Instagram — 사용자가 사이트 설정 페이지에서 본인 계정 입력 (env 불필요)
# 세션 쿠키 저장 위치 (Docker 사용 시 볼륨 마운트 권장)
INSTA_SESSION_DIR=/app/insta_sessions

# Environment
ENV=production
BASE_URL=https://your-domain.com

# CORS — JSON 리스트 (예: ["https://a.com","https://b.com"])
CORS_ORIGINS=["https://your-domain.com"]

# 결제 계좌 (계좌이체 — 사장님 입금받을 계좌)
BANK_NAME=국민은행
BANK_ACCOUNT=123-456-789012
BANK_HOLDER=김우진

# 최초 관리자 — 설정하면 이 이메일 계정만 /api/admin/bootstrap-first-admin 호출 가능 (권장)
ADMIN_EMAIL=admin@your-domain.com

# 카카오 로컬 API (강력 권장) — 공식 API라 차단 없이 업체 수집 (일 10만 건 무료)
# 발급: developers.kakao.com → 앱 생성 → REST API 키 복사 (5분 소요)
KAKAO_REST_API_KEY=

# 시스템 메일 (비밀번호 재설정 등 발송용 Gmail — 미설정 시 재설정 메일 발송 스킵)
SYSTEM_GMAIL_EMAIL=
SYSTEM_GMAIL_APP_PASSWORD=

# ── 프론트 분리 배포 시에만 (Vercel/Netlify) ──
# 빌드 환경변수로 설정: VITE_API_BASE_URL=https://api.your-domain.com/api
# 단일 Docker 배포(권장)에서는 불필요 — 백엔드가 same-origin으로 서빙
